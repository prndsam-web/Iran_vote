      </g></svg>`;
  } else {
    box.innerHTML = `<svg viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg">
      <rect width="300" height="66" fill="#0e7a3a"/><rect y="66" width="300" height="68" fill="#fff"/>
      <rect y="134" width="300" height="66" fill="#b71c1c"/>
      <text x="150" y="112" font-size="34" text-anchor="middle" fill="#b71c1c" font-family="serif">﷽</text></svg>`;
  }
}

/* ===== Chat ===== */
function renderChat(){
  const box = $('#chatMsgs');
  box.innerHTML = '';
  allChat.slice(-60).forEach(m=>{
    const d = document.createElement('div'); d.className = 'msg';
    if(currentUser && m.who === `${currentUser.name} ${currentUser.family}`) d.classList.add('mine');
    const w = document.createElement('span'); w.className='who'; w.textContent = m.who;
    const t = document.createElement('span'); t.textContent = m.text;
    d.append(w, t); box.appendChild(d);
  });
  box.scrollTop = box.scrollHeight;
}
$('#chatSend').addEventListener('click', async ()=>{
  if(!currentUser) return;
  const inp = $('#chatInput');
  const text = clean(inp.value);
  if(!text) return;
  await addChat({ who: `${currentUser.name} ${currentUser.family}`, text, t: Date.now() });
  inp.value = '';
});
$('#chatInput').addEventListener('keydown', e=>{ if(e.key==='Enter'){ e.preventDefault(); $('#chatSend').click(); }});

/* ===== Counter ===== */
function refreshUI(){
  const free = allVotes.filter(v=>v.vote==='freedom').length;
  const reg  = allVotes.filter(v=>v.vote==='regime').length;
  $('#cntFreedom').textContent = free;
  $('#cntRegime').textContent = reg;
  $('#cntTotal').textContent = allVotes.length;
  if(isAdmin) renderAdminTable();
}

/* ===== Admin ===== */
let isAdmin = false;
$('#adminToggle').addEventListener('click', ()=>{
  if(!isAdmin){ showAdminLogin(); return; }
  showAdminContent();
});
function showAdminLogin(){
  $$('section, .hero, #counterSection, .footer').forEach(s=>s.classList.add('hidden'));
  const panel = $('#adminPanel');
  panel.classList.remove('hidden');
  panel.innerHTML = `
    <div class="card" style="max-width:420px;">
      <h2>🔐 ورود مدیر</h2>
      <div class="field"><label>رمز عبور</label>
        <input type="password" id="adminPass" placeholder="رمز را وارد کنید"></div>
      <button class="btn" id="adminLoginBtn">ورود</button>
      <button class="btn ghost" id="adminBackBtn" style="margin-top:10px;">بازگشت به سایت</button>
      <div class="error hidden" id="adminError"></div>
    </div>`;
  $('#adminLoginBtn').addEventListener('click', ()=>{
    if($('#adminPass').value === 'سام'){ isAdmin = true; showAdminContent(); }
    else { const e=$('#adminError'); e.textContent='رمز اشتباه است.'; e.classList.remove('hidden'); }
  });
  $('#adminPass').addEventListener('keydown', e=>{ if(e.key==='Enter') $('#adminLoginBtn').click(); });
  $('#adminBackBtn').addEventListener('click', backToSite);
}
function showAdminContent(){
  const panel = $('#adminPanel');
  panel.classList.remove('hidden');
  $$('section, .hero, #counterSection, .footer').forEach(s=>s.classList.add('hidden'));
  panel.innerHTML = `
    <div class="card" style="max-width:100%;margin:20px auto;">
      <div class="status ${stateOpen?'open':'closed'}" id="statusBar">
        ${stateOpen?'🟢 رأی‌گیری فعال':'🔴 رأی‌گیری بسته شده'}
      </div>
      <div class="admin-stats">
        <div class="stat free"><div class="num" id="sFree">0</div><div class="lbl">آزادی</div></div>
        <div class="stat reg"><div class="num" id="sReg">0</div><div class="lbl">رژیم فعلی</div></div>
        <div class="stat"><div class="num" id="sTotal">0</div><div class="lbl">مجموع</div></div>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;">
        <button class="btn danger" id="admEnd">⏹ پایان رأی‌گیری و ارسال پیامک</button>
        <button class="btn ghost" id="admBack">بازگشت به سایت</button>
      </div>
      <h3 style="margin-top:20px;">لیست رأی‌دهندگان</h3>
      <div style="overflow-x:auto;">
        <table id="admTable"><thead><tr>
          <th>#</th><th>نام</th><th>خانوادگی</th><th>کد ملی</th>
          <th>شماره</th><th>رأی</th><th>زمان</th>
        </tr></thead><tbody></tbody></table>
      </div>
      <div id="admResult" style="margin-top:20px;text-align:center;font-weight:800;font-size:1.1rem;"></div>
    </div>`;
  renderAdminTable();
  $('#admBack').addEventListener('click', backToSite);
  $('#admEnd').addEventListener('click', endVoting);
}
function renderAdminTable(){
  const free = allVotes.filter(v=>v.vote==='freedom').length;
  const reg  = allVotes.filter(v=>v.vote==='regime').length;
  if($('#sFree')) $('#sFree').textContent = free;
  if($('#sReg'))  $('#sReg').textContent = reg;
  if($('#sTotal'))$('#sTotal').textContent = allVotes.length;
  const tb = $('#admTable tbody'); if(!tb) return;
  tb.innerHTML = '';
  allVotes.slice().sort((a,b)=>b.t-a.t).forEach((u, i)=>{
    const tr = document.createElement('tr');
    tr.innerHTML = `<td>${i+1}</td><td>${esc(u.name)}</td><td>${esc(u.family)}</td>
      <td>${esc(u.national_id)}</td><td>${esc(u.phone)}</td>
      <td>${u.vote==='freedom'?'<span class="badge free">آزادی</span>':'<span class="badge reg">رژیم فعلی</span>'}</td>
      <td>${new Date(u.t).toLocaleString('fa-IR')}</td>`;
    tb.appendChild(tr);
  });
}
function esc(s){ return String(s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

async function endVoting(){
  if(!confirm('مطمئنی؟ رأی‌گیری بسته می‌شود و پیامک نتیجه به همه ارسال می‌شود.')) return;
  await setVotingOpen(false);
  stateOpen = false;
  const free = allVotes.filter(v=>v.vote==='freedom').length;
  const reg  = allVotes.filter(v=>v.vote==='regime').length;
  const winner = free === reg ? 'مساوی' : free > reg ? 'آزادی' : 'رژیم فعلی';
  allVotes.forEach(v=> console.log(`[SMS-DEMO] → ${v.phone}: نتیجه: ${winner}`));
  $('#admResult').textContent = `🏆 برنده: ${winner}  |  📱 پیامک به ${allVotes.length} نفر ارسال شد (شبیه‌سازی)`;
  if($('#statusBar')){ $('#statusBar').textContent='🔴 رأی‌گیری بسته شده'; $('#statusBar').className='status closed'; }
  toast(`برنده: ${winner} — پیامک شبیه‌سازی شد`, 'success', 6000);
}

function backToSite(){
  $('#adminPanel').classList.add('hidden');
  $$('section, .hero, #counterSection, .footer').forEach(s=>s.classList.remove('hidden'));
  const last = history[history.length-1] || '#heroSection';
  show(last, false);
}

/* ===== Toast ===== */
function toast(msg, type='', ms=3500){
  const t = $('#toast');
  t.textContent = msg; t.className = 'show ' + type;
  clearTimeout(t._tid); t._tid = setTimeout(()=> t.className = '', ms);
}

/* ===== Init ===== */
(function init(){
  applyLang(currentLang);
  loadAll();
  if(currentUser){
    renderFlag(); renderChat();
    show('#successSection', false);
    history = ['#heroSection','#successSection'];
  } else {
    show('#heroSection', false);
  }
})();
</script>
