<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MIGA — Make Iran Great Again</title>
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;600;800;900&display=swap" rel="stylesheet">
<style>
:root{--green:#0e7a3a;--red:#b71c1c;--blue:#1a4f9c;--gold:#c9a227;
  --ink:#0f1720;--muted:#5a6675;--line:#e6ebf1;--bg:#f5f7fa;
  --shadow:0 8px 30px rgba(15,23,32,.08);--shadow-lg:0 20px 50px rgba(15,23,32,.15);}
*{box-sizing:border-box;margin:0;padding:0;font-family:'Vazirmatn',system-ui,sans-serif;}
body{color:var(--ink);min-height:100vh;overflow-x:hidden;background:var(--bg);
  background-image:repeating-linear-gradient(0deg,rgba(183,28,28,.045) 0 40px,rgba(255,255,255,0) 40px 80px);}
body::before{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;
  background:radial-gradient(circle at 10% 10%, rgba(26,79,156,.10), transparent 40%),
             radial-gradient(circle at 90% 90%, rgba(183,28,28,.10), transparent 45%);}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:14px 22px;
  background:rgba(255,255,255,.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--line);
  position:sticky;top:0;z-index:40;}
.brand{font-weight:900;letter-spacing:.5px;font-size:1.05rem;}
.brand .miga{color:var(--red);}
.back-btn{display:none;background:transparent;border:1px solid var(--line);padding:8px 14px;
  border-radius:10px;cursor:pointer;font-family:inherit;font-weight:600;color:var(--muted);transition:.2s;}
.back-btn:hover{border-color:var(--ink);color:var(--ink);}
.back-btn.show{display:inline-flex;align-items:center;gap:6px;}
.hero{max-width:960px;margin:0 auto;padding:60px 22px 20px;text-align:center;}
.hero h1{font-size:clamp(2rem,5vw,3.4rem);font-weight:900;letter-spacing:-.5px;line-height:1.1;}
.hero h1 .g{color:var(--green);} .hero h1 .r{color:var(--red);} .hero h1 .miga{color:var(--ink);}
.hero p{color:var(--muted);margin-top:14px;font-size:1.05rem;max-width:600px;margin-inline:auto;}
.lang-bar{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:28px auto 0;max-width:640px;}
.lang-btn{background:#fff;border:1.5px solid var(--line);color:var(--ink);padding:10px 22px;
  border-radius:12px;font-weight:700;cursor:pointer;font-family:inherit;font-size:.95rem;transition:.2s;}
.lang-btn:hover{border-color:var(--blue);color:var(--blue);transform:translateY(-1px);}
.lang-btn.active{background:var(--blue);color:#fff;border-color:var(--blue);
  box-shadow:0 6px 18px rgba(26,79,156,.3);}
section{display:none;animation:fade .35s ease;max-width:900px;margin:0 auto;padding:0 22px 60px;}
section.visible{display:block;}
@keyframes fade{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:none;}}
.coat-wrap{display:flex;justify-content:center;margin:40px 0;}
.coat{cursor:pointer;transition:.35s;max-width:340px;width:90%;
  filter:drop-shadow(0 24px 40px rgba(15,23,32,.18));}
.coat:hover{transform:translateY(-6px) scale(1.02);}
.disclaimer{max-width:680px;margin:24px auto;background:#fff;border-radius:18px;padding:28px;
  box-shadow:var(--shadow);border:2px solid var(--gold);position:relative;}
.disclaimer::before{content:"⚠️";position:absolute;top:-18px;left:50%;transform:translateX(-50%);
  background:#fff;width:38px;height:38px;border-radius:50%;display:flex;align-items:center;
  justify-content:center;font-size:1.4rem;border:2px solid var(--gold);}
.disclaimer h3{text-align:center;color:var(--gold);margin-bottom:14px;font-size:1.15rem;font-weight:900;}
.disclaimer p{color:var(--muted);line-height:2;font-size:.95rem;text-align:center;}
.vote-options{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:34px;}
@media(max-width:600px){.vote-options{grid-template-columns:1fr;}}
.vote-opt{border:2px solid transparent;padding:22px 18px;border-radius:18px;cursor:pointer;
  transition:.25s;background:#fff;box-shadow:var(--shadow);font-family:inherit;
  display:flex;flex-direction:column;align-items:center;gap:14px;}
.vote-opt:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg);border-color:var(--blue);}
.vote-opt .flag-svg{width:130px;height:auto;border-radius:8px;box-shadow:0 4px 12px rgba(0,0,0,.1);}
.vote-opt .label{font-weight:900;font-size:1.05rem;color:var(--ink);}
.vote-opt .sub{font-size:.8rem;color:var(--muted);}
.card{background:#fff;border-radius:20px;padding:34px 30px;box-shadow:var(--shadow);
  border:1px solid var(--line);max-width:520px;margin:24px auto;}
.card h2{text-align:center;margin-bottom:24px;font-size:1.35rem;font-weight:800;}
.field{margin-bottom:16px;}
.field label{display:block;font-size:.88rem;margin-bottom:8px;font-weight:700;color:var(--muted);}
.field input{width:100%;padding:14px 16px;border:1.5px solid var(--line);border-radius:12px;
  font-size:1rem;font-family:inherit;background:#fafbfc;transition:.2s;}
.field input:focus{outline:none;border-color:var(--blue);background:#fff;
  box-shadow:0 0 0 4px rgba(26,79,156,.1);}
.btn{width:100%;padding:15px;border:none;border-radius:12px;background:var(--blue);color:#fff;
  font-size:1.02rem;font-weight:800;cursor:pointer;transition:.2s;font-family:inherit;
  box-shadow:0 6px 18px rgba(26,79,156,.25);}
.btn:hover{background:#143e7c;transform:translateY(-1px);}
.btn.ghost{background:#fff;color:var(--muted);border:1.5px solid var(--line);box-shadow:none;}
.btn.ghost:hover{color:var(--ink);border-color:var(--ink);}
.btn.danger{background:var(--red);box-shadow:0 6px 18px rgba(183,28,28,.3);}
.btn.danger:hover{background:#8f1414;}
.btn:disabled{opacity:.5;cursor:not-allowed;}
.error{color:var(--red);font-size:.85rem;margin-top:10px;text-align:center;font-weight:600;}
.hint{color:var(--muted);font-size:.88rem;text-align:center;margin-bottom:16px;line-height:1.8;}
.flag-box{text-align:center;margin:20px 0 30px;}
.flag-box svg{width:180px;border-radius:10px;box-shadow:var(--shadow-lg);}
.counter{max-width:900px;margin:20px auto 60px;padding:0 22px;}
.counter-inner{background:linear-gradient(135deg,#0f1720,#1c262e);border-radius:22px;
  padding:32px 26px;color:#fff;box-shadow:var(--shadow-lg);display:grid;
  grid-template-columns:1fr 1fr 1fr;gap:18px;position:relative;overflow:hidden;}
.counter-inner::before{content:"";position:absolute;inset:0;
  background:repeating-linear-gradient(45deg,rgba(255,255,255,.02) 0 30px, transparent 30px 60px);
  pointer-events:none;}
.counter-item{text-align:center;position:relative;z-index:1;}
.counter-item .num{font-size:clamp(1.8rem,4vw,2.6rem);font-weight:900;letter-spacing:-1px;}
.counter-item.free .num{color:#7dffa8;}
.counter-item.reg .num{color:#ff9b9b;}
.counter-item .lbl{font-size:.82rem;opacity:.7;margin-top:6px;font-weight:600;}
.counter-title{text-align:center;font-weight:800;margin-bottom:16px;color:#fff;
  font-size:1.05rem;position:relative;z-index:1;grid-column:1/-1;}
@media(max-width:600px){.counter-inner{grid-template-columns:1fr;}}
.chat-box{max-width:640px;margin:30px auto;background:#fff;border-radius:20px;padding:22px;
  box-shadow:var(--shadow);border:1px solid var(--line);}
.chat-title{font-weight:800;margin-bottom:14px;font-size:1.05rem;display:flex;align-items:center;gap:8px;}
.chat-title::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--green);
  box-shadow:0 0 0 4px rgba(14,122,58,.2);}
.chat-msgs{height:280px;overflow-y:auto;background:#f7f9fc;border-radius:14px;padding:14px;
  margin-bottom:12px;border:1px solid var(--line);display:flex;flex-direction:column;gap:8px;}
.msg{padding:10px 14px;border-radius:12px;background:#fff;border:1px solid var(--line);
  font-size:.92rem;max-width:85%;word-wrap:break-word;box-shadow:0 1px 2px rgba(0,0,0,.03);}
.msg .who{font-weight:800;color:var(--blue);font-size:.78rem;display:block;margin-bottom:4px;}
.msg.mine{margin-left:auto;background:#eaf2ff;border-color:#cfe0ff;}
.chat-row{display:flex;gap:8px;}
.chat-row input{flex:1;padding:12px 16px;border:1.5px solid var(--line);border-radius:12px;
  font-family:inherit;font-size:.95rem;background:#fafbfc;}
.chat-row input:focus{outline:none;border-color:var(--blue);background:#fff;}
.chat-row button{padding:12px 22px;border:none;border-radius:12px;background:var(--blue);
  color:#fff;font-weight:700;cursor:pointer;font-family:inherit;}
.chat-row button:hover{background:#143e7c;}
.admin-link{position:fixed;bottom:22px;left:22px;z-index:50;}
.admin-link button{padding:11px 18px;border:none;border-radius:12px;background:#0f1720;color:#fff;
  font-weight:700;cursor:pointer;font-family:inherit;font-size:.88rem;
  box-shadow:var(--shadow-lg);opacity:.9;}
.admin-link button:hover{opacity:1;transform:translateY(-2px);}
.admin-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:20px;}
@media(max-width:600px){.admin-stats{grid-template-columns:1fr;}}
.stat{padding:18px;border-radius:14px;background:#f7f9fc;border:1px solid var(--line);text-align:center;}
.stat .num{font-size:1.9rem;font-weight:900;letter-spacing:-1px;}
.stat.free .num{color:var(--green);}
.stat.reg .num{color:var(--red);}
.stat .lbl{color:var(--muted);font-size:.85rem;font-weight:700;margin-top:6px;}
table{width:100%;border-collapse:collapse;margin-top:14px;font-size:.88rem;}
th,td{padding:12px 10px;text-align:right;border-bottom:1px solid var(--line);}
th{background:#f7f9fc;font-weight:800;color:#333;font-size:.82rem;}
tr:hover{background:#fafbfc;}
.badge{display:inline-block;padding:4px 12px;border-radius:20px;font-size:.78rem;font-weight:800;}
.badge.free{background:#e6f7ea;color:var(--green);}
.badge.reg{background:#fde7e7;color:var(--red);}
.status{padding:14px 18px;border-radius:12px;font-weight:800;text-align:center;margin-bottom:18px;}
.status.open{background:#e6f7ea;color:var(--green);}
.status.closed{background:#fde7e7;color:var(--red);}
#toast{position:fixed;top:22px;left:50%;transform:translateX(-50%) translateY(-140%);
  background:#0f1720;color:#fff;padding:15px 26px;border-radius:14px;font-weight:600;z-index:999;
  transition:.4s cubic-bezier(.2,.9,.3,1.2);box-shadow:var(--shadow-lg);max-width:90%;
  text-align:center;font-size:.92rem;}
#toast.show{transform:translateX(-50%) translateY(0);}
#toast.success{background:var(--green);}
#toast.error{background:var(--red);}
.footer{text-align:center;padding:30px 20px 80px;color:var(--muted);font-size:.88rem;line-height:2;}
.footer b{color:var(--red);font-weight:900;}
.footer .heart{color:var(--red);}
.hidden{display:none!important;}
</style>
</head>
