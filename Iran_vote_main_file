/* ===== State ===== */
const $ = s => document.querySelector(s);
const $$ = s => document.querySelectorAll(s);
const clean = s => String(s ?? '').replace(/[<>"'`]/g, '').trim();

let currentLang = localStorage.getItem('miga_lang') || 'fa';
let pendingVote = null;
let currentUser = JSON.parse(localStorage.getItem('miga_user') || 'null');
let stateOpen = true;
let allVotes = [];
let allChat = [];

/* ===== Data layer (Firebase) ===== */
function loadAll(){
  onValue(ref(db, 'votes'), snap => {
    const val = snap.val() || {};
    allVotes = Object.values(val);
    refreshUI();
  });
  onValue(ref(db, 'chat'), snap => {
    const val = snap.val() || {};
    allChat = Object.values(val).sort((a,b)=>a.t-b.t);
    renderChat();
  });
  onValue(ref(db, 'state'), snap => {
    stateOpen = (snap.val()?.open !== false);
  });
}
async function addVote(rec){ await push(ref(db, 'votes'), rec); }
async function addChat(rec){ await push(ref(db, 'chat'), rec); }
async function setVotingOpen(open){ await push(ref(db, 'state'), { open, t: Date.now() }); }

/* ===== Navigation ===== */
const STEPS = ['#heroSection','#coatSection','#disclaimerSection','#voteOptionsSection',
                '#voteFormSection','#otpSection','#successSection'];
let history = ['#heroSection'];
function show(id, push=true){
  $$('section, .hero').forEach(s=>s.classList.remove('visible'));
  const el = $(id); if(el) el.classList.add('visible');
  if(push && history[history.length-1] !== id) history.push(id);
  const idx = STEPS.indexOf(id);
  const bb = $('#backBtn');
  if(idx > 0 && id !== '#successSection') bb.classList.add('show');
  else bb.classList.remove('show');
  window.scrollTo({top:0, behavior:'smooth'});
}
$('#backBtn').addEventListener('click', ()=>{
  if(history.length > 1){ history.pop(); show(history[history.length-1] || '#heroSection', false); }
});

/* ===== Language ===== */
function applyLang(lang){
  currentLang = lang;
  localStorage.setItem('miga_lang', lang);
  const t = T[lang];
  document.documentElement.lang = lang;
  document.documentElement.dir = t.dir;
  $$('.lang-btn').forEach(b=>b.classList.toggle('active', b.dataset.lang===lang));
  $('#backBtn').textContent = '← ' + t.back;
  $('#heroDesc').textContent = t.heroDesc;
  $('#discTitle').textContent = t.discTitle;
  $('#discText').textContent = t.discText;
  $('#lblOptFreedom').textContent = t.freedom;
  $('#lblOptFreedomSub').textContent = t.freedomSub;
  $('#lblOptRegime').textContent = t.regime;
  $('#lblOptRegimeSub').textContent = t.regimeSub;
  $('#formTitle').textContent = t.formTitle;
  $('#lblName').textContent = t.name;
  $('#lblFamily').textContent = t.family;
  $('#lblNid').textContent = t.nid;
  $('#lblPhone').textContent = t.phone;
  $('#btnSendOtp').textContent = t.sendOtp;
  $('#otpTitle').textContent = t.otpTitle;
  $('#lblOtp').textContent = t.otpLbl;
  $('#btnVerifyOtp').textContent = t.verify;
  $('#chatTitle').textContent = t.chatTitle;
  $('#chatInput').placeholder = t.chatPlaceholder;
  $('#chatSend').textContent = t.send;
  $('#counterTitle').textContent = t.counterTitle;
  $('#lblCntFree').textContent = t.free;
  $('#lblCntReg').textContent = t.reg;
  $('#lblCntTotal').textContent = t.total;
  $('#logoutBtn').textContent = t.logout;
  $('#footerText').innerHTML = t.footer;
}
$$('.lang-btn').forEach(b=> b.addEventListener('click', ()=> applyLang(b.dataset.lang)));

/* ===== Flow ===== */
$('#coatBtn').addEventListener('click', ()=>{
  if(!stateOpen){ toast(T[currentLang].closed, 'error'); return; }
  show('#disclaimerSection');
});
$('#discAccept').addEventListener('click', ()=> show('#voteOptionsSection'));
$$('.vote-opt').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    if(!stateOpen){ toast(T[currentLang].closed, 'error'); return; }
    pendingVote = { vote: btn.dataset.vote };
    show('#voteFormSection');
  });
});

$('#voteForm').addEventListener('submit', async e=>{
  e.preventDefault();
  const f = e.target;
  const err = $('#formError'); err.classList.add('hidden');
  const body = {
    name: clean(f.name.value), family: clean(f.family.value),
    national_id: clean(f.national_id.value), phone: clean(f.phone.value),
    vote: pendingVote?.vote
  };
  if(!body.name || !body.family || !/^09\d{9}$/.test(body.phone) || !/^\d{10}$/.test(body.national_id)){
    err.textContent = T[currentLang].errFill; err.classList.remove('hidden'); return;
  }
  if(allVotes.some(v=>v.national_id === body.national_id)){
    err.textContent = T[currentLang].dup; err.classList.remove('hidden'); return;
  }
  const otp = String(Math.floor(100000 + Math.random()*900000));
  pendingVote = { ...pendingVote, ...body, otp };
  toast(T[currentLang].otpSent + otp, 'success', 8000);
  $('#otpDesc').textContent = T[currentLang].otpDesc(body.phone);
  $('#otpInput').value = '';
  show('#otpSection');
});

$('#btnVerifyOtp').addEventListener('click', async ()=>{
  const err = $('#otpError'); err.classList.add('hidden');
  const code = $('#otpInput').value.trim();
  if(!pendingVote || code !== pendingVote.otp){
    err.textContent = T[currentLang].errOtp; err.classList.remove('hidden'); return;
  }
  const rec = {
    name: pendingVote.name, family: pendingVote.family,
    national_id: pendingVote.national_id, phone: pendingVote.phone,
    vote: pendingVote.vote, t: Date.now()
  };
  await addVote(rec);
  currentUser = rec;
  localStorage.setItem('miga_user', JSON.stringify(currentUser));
  toast(T[currentLang].voted, 'success');
  renderFlag(); renderChat();
  pendingVote = null;
  show('#successSection');
});

$('#logoutBtn').addEventListener('click', ()=>{
  localStorage.removeItem('miga_user');
  currentUser = null; pendingVote = null;
  $('#voteForm').reset();
  history = ['#heroSection']; show('#heroSection', false);
});

/* ===== Flag ===== */
